# Host and Port configuration
HOST=127.0.0.1
PORT=8000

# TrOCR Model identifier from Hugging Face
# Default: microsoft/trocr-base-handwritten
MODEL_NAME=microsoft/trocr-base-handwritten

# Hardware device: "cpu" or "cuda" (auto-detected if blank)
DEVICE=cpu

# Optional shared API secret for ESP32 and authenticated endpoints
ESP32_API_KEY=esp32_secret_demo_key

# CORS allowed origins (comma-separated, or * for all in development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

