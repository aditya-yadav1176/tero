# ==============================================================================
# Tero Frontend Environment Variables
# ==============================================================================

# Recognition Backend API URL:
# - Local development (laptop): http://127.0.0.1:8000
# - Mobile testing on local LAN: http://<YOUR_LAPTOP_IP>:8000
# - Production on Vercel: https://your-fastapi-backend.onrender.com (or Hugging Face Space)
# NOTE: Never use localhost as the production backend URL when deploying to Vercel!
VITE_API_BASE_URL=http://127.0.0.1:8000

# ==============================================================================
# Optional: Firebase Spark Plan Free Tier (Cross-Device Phone/Laptop Sync)
# ==============================================================================
# Firebase is 100% OPTIONAL. If left empty, Tero uses browser IndexedDB locally.
# If configured, recognition metadata syncs between your phone and laptop in real time.
# Handwriting stroke images are kept in IndexedDB to avoid any paid storage plans.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
